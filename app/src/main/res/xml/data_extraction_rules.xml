<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: backup na nuvem do Google e transferência entre aparelhos levam o banco local. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
